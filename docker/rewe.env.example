# Kopieren nach docker/rewe.env (nicht committen!) und Werte setzen.
# Passwörter z.B. mit: openssl rand -hex 24
REWE_DB_PASSWORD=
# Passwort der Rolle "n8n" (Lesen + Angebotsfelder schreiben), dasselbe kommt ins n8n-Credential "REWE Postgres"
REWE_DB_N8N_PASSWORD=
# Markt-IDs aus GET http://rewe-service:8000/markets/search?q=<PLZ oder Ort>
# Sortiment und Preise: ein Markt mit Abholservice (Ladenpreise, volles Sortiment),
# z.B. 1940222 = REWE Warendorfer Str. 54, Münster
REWE_MARKET_ID=
# Angebote: der Markt, in dem eingekauft wird, z.B. 1940430 = REWE Catharina-Müller-Str. 4-8, Münster Nord
REWE_ANGEBOTE_MARKET_ID=
