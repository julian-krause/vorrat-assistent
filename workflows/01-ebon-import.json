      {
        "id": "6cc2a830-2c95-444f-9d03-ecf717760545",
        "name": "Produkte zuordnen",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          2688,
          96
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const norm = s => String(s || '').toLowerCase().replace(/[^a-z0-9äöüß%,.]+/g, ' ').trim();\nconst arts = $('Artikel aufbereiten').all().map(i => i.json);\nconst prods = $('Grocy-Produkte laden').all().map(i => i.json).filter(p => p && p.id);\nconst qus = $('Grocy-Einheiten laden').all().map(i => i.json).filter(p => p && p.id);\nconst locs = $('Grocy-Lagerorte laden').all().map(i => i.json).filter(p => p && p.id);\nconst quId = n => (qus.find(q => norm(q.name) === norm(n)) || {}).id;\nconst quIds = { g: quId('Gramm'), ml: quId('Milliliter'), stk: quId('Stück') };\nif (!quIds.g || !quIds.ml || !quIds.stk) throw new Error('In Grocy fehlen die Einheiten Gramm/Milliliter/Stück – bitte einmal den Workflow „Vorrat · Grocy einrichten“ ausführen.');\nconst quCode = { [quIds.g]: 'g', [quIds.ml]: 'ml', [quIds.stk]: 'stk' };\nconst locId = n => (locs.find(l => norm(l.name) === norm(n)) || locs[0] || {}).id;\nconst byName = {};\nfor (const p of prods) byName[norm(p.name)] = p;\n\nreturn arts.map(a => {\n  const p = byName[norm(a.name)];\n  let menge = a.menge;\n  let einheit = a.einheit;\n  if (p) {\n    const pe = quCode[p.qu_id_stock];\n    if (pe && pe !== einheit) {\n      if (pe === 'g' && einheit === 'stk' && a.gramm_pro_stk) menge = a.menge * a.gramm_pro_stk;\n      else if (pe === 'stk' && einheit === 'g' && a.gramm_pro_stk) menge = Math.max(1, Math.round(a.menge / a.gramm_pro_stk));\n      einheit = pe;\n    }\n  }\n  return { json: { ...a, product_id: p ? p.id : null, menge, einheit, qu_id: quIds[einheit], location_id: locId(a.lagerort) } };\n});"
        }
      },
