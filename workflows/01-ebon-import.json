        "id": "233710ac-9f98-4bcb-a848-87abddfd0fe9",
        "name": "In Grocy einbuchen",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          4256,
          0
        ],
        "parameters": {
          "method": "POST",
          "url": "={{ $('Profil laden').first().json.grocy_url }}/api/stock/products/{{ $json.product_id }}/add",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpTemplatedCustomAuth",
          "sendBody": true,
          "contentType": "json",
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ amount: $json.menge, best_before_date: $json.mhd, purchased_date: $json.kaufdatum, transaction_type: \"purchase\", location_id: $json.location_id }) }}",
          "options": {}
        }
