      {
        "id": "d1bc7ee0-fb87-4476-acc7-d003e0dafda5",
        "name": "Bons zusammenfassen",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          4480,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const arts = $('Alle Artikel').all().map(i => i.json);\nconst esc = t => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst heute = DateTime.now().setZone('Europe/Berlin').startOf('day');\nconst byBon = {};\nfor (const a of arts) (byBon[a.bon_id] = byBon[a.bon_id] || []).push(a);\nreturn Object.keys(byBon).map(id => {\n  const l = byBon[id].sort((x, y) => String(x.mhd).localeCompare(String(y.mhd)));\n  const datum = DateTime.fromISO(l[0].kaufdatum).setLocale('de');\n  const zeilen = l.map(a => {\n    const m = DateTime.fromISO(a.mhd).setLocale('de');\n    const tage = Math.round(m.diff(heute, 'days').days);\n    return '• ' + esc(a.name) + ' – ' + a.menge + ' ' + a.einheit + ' · ca. bis ' + m.toFormat('ccc dd.LL.') + (tage <= 2 ? ' ⚠️' : '') + (a.nutriscore ? ' · NS ' + a.nutriscore : '');\n  });\n  const neu = l.filter(a => a.quelle).length;\n  const off = l.filter(a => a.quelle === 'openfoodfacts').length;\n  const text = '🧾 <b>REWE-Einkauf vom ' + datum.toFormat('dd.LL.yyyy') + ' in Grocy gebucht</b>\\n'\n    + l.length + ' Lebensmittel' + (l[0].bon_summe ? ' · ' + l[0].bon_summe.toFixed(2).replace('.', ',') + ' €' : '')\n    + (neu ? ' · ' + neu + ' neue Produkte (' + off + ' mit OpenFoodFacts-Nährwerten)' : '') + '\\n\\n'\n    + zeilen.join('\\n')\n    + '\\n\\n<i>Haltbarkeit ist geschätzt. Korrigieren z.B. mit: „Joghurt hält bis 15.10.“</i>\\nRezeptideen kommen gleich 🍳';\n  return { json: { message_id: id, datum: l[0].kaufdatum, summe: l[0].bon_summe || 0, anzahl_artikel: l.length, text } };\n});"
        }
      },
