      {
        "id": "34a8b2ce-9c88-4a20-8a4c-abbd381deb48",
        "name": "Bon vorbereiten",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          672,
          192
        ],
        "parameters": {
          "mode": "runOnceForEachItem",
          "language": "javaScript",
          "jsCode": "const src = $('PDF-Anhang finden').item.json;\nconst text = String($json.text || '');\nconst kaufdatum = src.mail_datum ? DateTime.fromJSDate(new Date(src.mail_datum)).setZone('Europe/Berlin').toISODate() : DateTime.now().setZone('Europe/Berlin').toISODate();\n\nconst system = 'Du wandelst deutsche Supermarkt-Kassenbons (REWE eBon) in strukturierte Vorratsdaten um. Antworte ausschließlich mit gültigem JSON.';\nconst prompt = 'Kaufdatum laut Mail: ' + kaufdatum + '\\n'\n  + 'AUFGABE: Extrahiere alle LEBENSMITTEL-Positionen aus dem Bon.\\n'\n  + 'REGELN:\\n'\n  + '- Ignoriere Pfand, Leergut, Tüten, Rabatte, Coupons, Payback, Summen, Zahlungsinfos und Non-Food (Drogerie, Haushalt, Tierbedarf).\\n'\n  + '- name: kurzer, generischer deutscher Produktname ohne Marke (z.B. \"BIO ZUCCHINI\" -> \"Zucchini\", \"JA H-MILCH 1,5%\" -> \"H-Milch 1,5 %\"). Gleiche Produkte sollen bei jedem Einkauf exakt gleich heißen.\\n'\n  + '- off_suche: bester Suchbegriff für OpenFoodFacts inkl. erkennbarer Marke (REWE-Eigenmarken: \"ja!\", \"REWE Beste Wahl\", \"REWE Bio\"), z.B. \"ja! H-Milch 1,5%\".\\n'\n  + '- frischware: true für loses Obst/Gemüse, Brot vom Bäcker, Fleisch/Käse von der Theke; sonst false.\\n'\n  + '- menge + einheit: nur \"g\", \"ml\" oder \"stk\" als Gesamtmenge. Packungsgrößen umrechnen (1 L -> 1000 ml, 0,512 kg -> 512 g). Zeilen wie \"2 Stk x 0,99\" multiplizieren. packungen = Anzahl Packungen.\\n'\n  + '- menge_geschaetzt: true, wenn keine Größe auf dem Bon steht und du die übliche Packungsgröße schätzt (Joghurt 500 g, Nudeln 500 g, Butter 250 g, Quark 500 g, Eier 10 stk). Obst/Gemüse ohne Gewicht als stk.\\n'\n  + '- gramm_pro_stk: ungefähres Gewicht eines Stücks (nur bei einheit stk, z.B. Zucchini 250, Ei 60, Apfel 150), sonst null.\\n'\n  + '- naehrwerte_100g: typische Nährwerte pro 100 g bzw. 100 ml (Schätzung): kcal, protein, fett, kh.\\n'\n  + '- kategorie: eine von Obst, Gemüse, Fleisch, Fisch, Milchprodukte, Käse, Eier, Brot & Backwaren, Getreide & Nudeln, Hülsenfrüchte, Konserven, Tiefkühl, Gewürze & Öle, Snacks & Süßes, Getränke, Sonstiges.\\n'\n  + '- lagerort: Kühlschrank, Tiefkühler oder Vorratsschrank.\\n'\n  + '- haltbarkeit_tage: realistische geschätzte Haltbarkeit ab Kauf bei richtiger Lagerung. Richtwerte: Hackfleisch 1, frischer Fisch 1, Hähnchen 2, Salat 3, Beeren 3, Brot 4, Tomaten 5, Brokkoli 5, Frischmilch 7, Zucchini 7, Paprika 7, Joghurt 14, Karotten 21, Eier 21, Hartkäse 28, Äpfel 30, Kartoffeln 30, H-Milch 90, Tiefkühl 180, Nudeln/Reis 365, Konserven 730.\\n'\n  + 'FORMAT: {\"kaufdatum\":\"YYYY-MM-DD\",\"summe\":23.45,\"artikel\":[{\"name\":\"Zucchini\",\"bon_text\":\"BIO ZUCCHINI\",\"off_suche\":\"Zucchini\",\"frischware\":true,\"kategorie\":\"Gemüse\",\"menge\":2,\"einheit\":\"stk\",\"packungen\":2,\"menge_geschaetzt\":false,\"gramm_pro_stk\":250,\"naehrwerte_100g\":{\"kcal\":17,\"protein\":1.2,\"fett\":0.3,\"kh\":2.2},\"lagerort\":\"Kühlschrank\",\"haltbarkeit_tage\":7}]}\\n\\n'\n  + 'BON-TEXT:\\n' + text;\n\nreturn { json: { message_id: src.message_id, kaufdatum, lesbar: text.replace(/\\s+/g, '').length > 40, system, prompt } };"
        }
      },
