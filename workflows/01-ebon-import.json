      {
        "id": "1059c18b-ca72-4398-9208-783360d471bf",
        "name": "Nährwerte bestimmen",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          3360,
          176
        ],
        "parameters": {
          "mode": "runOnceForEachItem",
          "language": "javaScript",
          "jsCode": "const a = $('Produkte zuordnen').item.json;\nconst hits = ($json && Array.isArray($json.products)) ? $json.products : [];\nconst norm = s => String(s || '').toLowerCase().replace(/[^a-z0-9äöüß]+/g, ' ').trim();\nconst woerter = norm(a.name).split(' ').filter(w => w.length > 2);\nlet best = null;\nlet bestScore = 0;\nfor (const p of hits) {\n  const n = p.nutriments || {};\n  if (n['energy-kcal_100g'] == null) continue;\n  const pn = norm((p.product_name || '') + ' ' + (p.brands || ''));\n  const score = woerter.length ? woerter.filter(w => pn.includes(w)).length / woerter.length : 0;\n  if (score > bestScore) { best = p; bestScore = score; }\n}\nconst ok = !!best && bestScore >= (a.frischware ? 1 : 0.5);\nconst n = ok ? best.nutriments : {};\nconst r1 = v => (v === null || v === undefined || isNaN(Number(v))) ? null : Math.round(Number(v) * 10) / 10;\nlet menge = a.menge;\nif (ok && a.menge_geschaetzt && ['g', 'ml'].includes(a.einheit) && Number(best.product_quantity) > 0) menge = Number(best.product_quantity) * (a.packungen || 1);\nconst kcal_100 = ok ? r1(n['energy-kcal_100g']) : r1(a.ki_kcal_100);\nconst faktor = a.einheit === 'stk' ? (a.gramm_pro_stk || 100) / 100 : 0.01;\nconst hinweis = ok ? ['Nutri-Score ' + String(best.nutriscore_grade || '?').toUpperCase(), best.nova_group ? 'NOVA ' + best.nova_group : '', 'OFF ' + best.code].filter(Boolean).join(' · ') : 'Nährwerte geschätzt';\nreturn { json: {\n  ...a,\n  menge,\n  kcal_100,\n  protein_100: ok ? r1(n.proteins_100g) : r1(a.ki_protein_100),\n  fett_100: ok ? r1(n.fat_100g) : r1(a.ki_fett_100),\n  kh_100: ok ? r1(n.carbohydrates_100g) : r1(a.ki_kh_100),\n  nutriscore: ok && best.nutriscore_grade && best.nutriscore_grade.length === 1 ? best.nutriscore_grade.toUpperCase() : '',\n  nova: ok && best.nova_group ? Number(best.nova_group) : null,\n  off_code: ok ? String(best.code || '') : '',\n  off_name: ok ? String((best.brands ? best.brands + ' ' : '') + (best.product_name || '')) : '',\n  quelle: ok ? 'openfoodfacts' : 'ki-schaetzung',\n  kcal_pro_einheit: kcal_100 == null ? 0 : Math.round(kcal_100 * faktor * 100) / 100,\n  beschreibung: hinweis\n} };"
        }
      },
      {
