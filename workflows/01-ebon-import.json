      {
        "id": "49a1ab97-2222-4cbb-aae6-50748023f68b",
        "name": "Artikel aufbereiten",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1568,
          96
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const zone = 'Europe/Berlin';\nconst zahl = v => (v === null || v === undefined || v === '' || isNaN(Number(v))) ? null : Number(v);\nconst out = [];\n$input.all().forEach((item, i) => {\n  const bon = $('Bon vorbereiten').itemMatching(i).json;\n  const c = item.json.choices && item.json.choices[0] && item.json.choices[0].message ? String(item.json.choices[0].message.content || '') : '';\n  const s = c.includes('</think>') ? c.split('</think>').pop() : c;\n  const a = s.indexOf('{');\n  const b = s.lastIndexOf('}');\n  if (a < 0 || b < 0) throw new Error('KI-Antwort enthält kein JSON: ' + s.slice(0, 300));\n  const data = JSON.parse(s.slice(a, b + 1));\n  const kaufdatum = /^\\d{4}-\\d{2}-\\d{2}$/.test(String(data.kaufdatum || '')) ? data.kaufdatum : bon.kaufdatum;\n  const kauf = DateTime.fromISO(kaufdatum, { zone });\n  for (const art of (data.artikel || [])) {\n    const tage = Math.max(0, Math.round(Number(art.haltbarkeit_tage) || 7));\n    const einheit = ['g', 'ml', 'stk'].includes(String(art.einheit).toLowerCase()) ? String(art.einheit).toLowerCase() : 'stk';\n    const nw = art.naehrwerte_100g || {};\n    out.push({ json: {\n      name: String(art.name || art.bon_text || 'Unbekannt').trim(),\n      bon_text: String(art.bon_text || ''),\n      off_suche: String(art.off_suche || art.name || ''),\n      frischware: art.frischware === true,\n      kategorie: String(art.kategorie || 'Sonstiges'),\n      menge: Number(art.menge) || 1,\n      einheit,\n      packungen: Number(art.packungen) || 1,\n      menge_geschaetzt: art.menge_geschaetzt === true,\n      gramm_pro_stk: zahl(art.gramm_pro_stk),\n      ki_kcal_100: zahl(nw.kcal), ki_protein_100: zahl(nw.protein), ki_fett_100: zahl(nw.fett), ki_kh_100: zahl(nw.kh),\n      lagerort: String(art.lagerort || 'Vorratsschrank'),\n      haltbarkeit_tage: tage,\n      kaufdatum: kauf.toISODate(),\n      mhd: kauf.plus({ days: tage }).toISODate(),\n      bon_id: bon.message_id,\n      bon_summe: Number(data.summe) || 0\n    } });\n  }\n});\nreturn out;"
        }
      },
