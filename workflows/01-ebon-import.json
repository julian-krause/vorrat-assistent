        "id": "15bf5715-846d-4d1a-bb36-f7128d0c318b",
        "name": "PDF-Anhang finden",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          224,
          192
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const bin = item.binary || {};\n  const key = Object.keys(bin).find(k => String(bin[k].mimeType || '').includes('pdf') || String(bin[k].fileName || '').toLowerCase().endsWith('.pdf'));\n  if (!key) continue;\n  const j = item.json;\n  out.push({\n    json: { message_id: String(j.messageId || ((j.subject || '') + '|' + (j.date || ''))), betreff: j.subject || '', mail_datum: j.date || '' },\n    binary: { data: bin[key] }\n  });\n}\nreturn out;"
        }
      },
