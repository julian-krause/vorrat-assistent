          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ model: \"MiniMax-M3\", thinking: { type: \"disabled\" }, temperature: 0, max_tokens: 2000, messages: [ { role: \"system\", content: $json.system }, { role: \"user\", content: $json.prompt } ] }) }}",
