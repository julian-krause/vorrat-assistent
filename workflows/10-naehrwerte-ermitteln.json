      {
        "id": "d4000000-0017-4000-8000-naehrwert017",
        "name": "Endergebnis",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1980,
          260
        ],
        "executeOnce": false,
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "// Endergebnis je Produkt: zweite Ermittlung (mit BLS) ersetzt die erste\nconst erg = $('Ermitteln').all().map(i => i.json || {});\nlet zweite = [], anfragen = [];\ntry { zweite = $('Mit BLS ermitteln').all().map(i => i.json || {}); anfragen = $('BLS-Anfragen').all().map(i => i.json || {}); } catch (e) {}\nanfragen.forEach((a, k) => { if (a && a.idx !== undefined && zweite[k] && zweite[k].produkt) erg[a.idx] = zweite[k]; });\nreturn erg.map(r => ({ json: r }));"
        }
      }
