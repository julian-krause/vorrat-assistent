      {
        "id": "d4000000-0005-4000-8000-naehrwert005",
        "name": "Grocy-kcal bekannt?",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          880,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "// Grocy-kcal ist nur eine Kopie der View: kcal pro Lagereinheit (g/ml: kcal/100 g ÷ 100, Stück: × Stückgewicht)\nreturn $('Ermitteln').all().map(i => (i.json && i.json.produkt) || {})\n  .filter(p => p.grocy_product_id && p.kcal_pro_einheit !== null && p.kcal_pro_einheit !== undefined)\n  .map(p => ({ json: { id: p.grocy_product_id, calories: p.kcal_pro_einheit } }));"
        }
      },
      {
        "id": "d4000000-0006-4000-8000-naehrwert006",
        "name": "Grocy-kcal setzen",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1100,
          0
        ],
        "credentials": {
          "httpCustomAuth": {
            "id": "sWOsDlhSjQx2Y5EN",
            "name": "Custom Auth account"
          }
        },
        "parameters": {
          "method": "PUT",
          "url": "={{ $('Profil laden').first().json.grocy_url }}/api/objects/products/{{ $json.id }}",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpCustomAuth",
          "sendBody": true,
          "contentType": "json",
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ calories: $json.calories }) }}",
          "options": {
            "batching": {
              "batch": {
                "batchSize": 1,
                "batchInterval": 200
              }
            }
          }
        }
      },
      {
        "id": "d4000000-0007-4000-8000-naehrwert007",
        "name": "Ergebnis",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          880,
          200
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "// Ergebnis je Produkt (für eBon-Import und Bot): beste Quelle, Rang, Werte, Grocy-kcal\nreturn $('Ermitteln').all().map(i => {\n  const r = i.json || {};\n  const p = r.produkt || {};\n  return { json: {\n    grocy_product_id: p.grocy_product_id ?? null, name: p.name ?? null, quelle: p.naehrwert_quelle ?? r.quelle ?? null,\n    rang: p.naehrwert_rang ?? r.rang ?? null, kcal_100: p.kcal_100 ?? null, protein_100: p.protein_100 ?? null,\n    fett_100: p.fett_100 ?? null, kh_100: p.kh_100 ?? null, gramm_pro_stk: p.gramm_pro_stk ?? null, gramm_quelle: p.gramm_quelle ?? null,\n    geschaetzt: p.geschaetzt ?? true, kcal_pro_einheit: p.kcal_pro_einheit ?? null, rewe_product_id: p.rewe_product_id ?? null,\n    naehrwerte_status: r.naehrwerte_status ?? null, hinweise: r.hinweise || [], schritte: r.schritte || [],\n    fehler: r.error ? (r.error.message || String(r.error)) : (r.detail && !r.quelle && !r.produkt ? r.detail : null),\n  } };\n});"
        }
      },
      {
        "id": "d4000000-0008-4000-8000-naehrwert008",
        "name": "Notiz",
        "type": "n8n-nodes-base.stickyNote",
        "typeVersion": 1,
        "position": [
          0,
          -320
        ],
        "parameters": {
          "width": 900,
          "height": 280,
          "color": 4,
          "content": "## Nährwerte ermitteln (Unter-Workflow)\nGenutzt vom eBon-Import, vom Bot-Tool `naehrwerte_merken` und von der Bon-Rückfrage.\n`POST /naehrwerte/ermitteln` arbeitet die Rangfolge ab: REWE (fehlende/über 7 Tage alte Details werden sofort nachgeladen) → Open Food Facts per Barcode → per Name (nur gleiche Marke) → BLS → KI. Gespeichert wird in `vorrat_produkte` (schlechter überschreibt nie besser). Danach wird das kcal-Feld in Grocy aus der View `vorrat_naehrwerte` neu gesetzt.\nRückgabe: je Produkt Quelle, Rang, Werte, `geschaetzt`."
        }
      }
