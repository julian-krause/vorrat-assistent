      {
        "id": "d4000000-0002-4000-8000-naehrwert002",
        "name": "Anfrage bauen",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          220,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "// Eingaben -> Anfrage an POST /naehrwerte/ermitteln (mit Speichern in vorrat_produkte)\nconst z = v => (v === null || v === undefined || v === '' || isNaN(Number(v))) ? null : Number(v);\nreturn $input.all().map(i => {\n  const e = i.json;\n  const ki = z(e.kcal_100) > 0 ? { kcal: z(e.kcal_100), protein: z(e.protein_100), fett: z(e.fett_100), kh: z(e.kh_100) } : null;\n  return { json: {\n    grocy_product_id: z(e.grocy_product_id), name: e.name || '', marke: e.marke || null, rewe_product_id: e.rewe_product_id ? String(e.rewe_product_id) : null,\n    ean: e.ean ? String(e.ean) : null, einheit: e.einheit || null, kategorie: e.kategorie || null,\n    ki_naehrwerte: ki, werte_quelle: e.werte_quelle === 'manuell' ? 'manuell' : 'ki',\n    gramm_pro_stk: z(e.gramm_pro_stk), gramm_quelle: e.gramm_quelle || 'ki', mit_schale: e.mit_schale || null, bls_suche: e.bls_suche || null, speichern: true,\n  } };\n});"
        }
      },
