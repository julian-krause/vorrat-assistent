      {
        "id": "d4000000-0014-4000-8000-naehrwert014",
        "name": "BLS-Anfragen",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1320,
          160
        ],
        "alwaysOutputData": true,
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "// Gewählte BLS-Codes -> zweite Ermittlung mit bls_code (die Werte liest der Dienst aus der BLS-Tabelle)\nconst c = (($json.choices || [])[0] || {}).message || {};\nconst text = String(c.content || '').split('</think>').pop();\nlet wahl = {};\ntry { wahl = JSON.parse(text.slice(text.indexOf('{'), text.lastIndexOf('}') + 1)).wahl || {}; } catch (e) { wahl = {}; }\nconst anfragen = $('Anfrage bauen').all().map(i => i.json);\nconst out = [];\nfor (const [idx, code] of Object.entries(wahl)) {\n  const a = anfragen[Number(idx)];\n  if (a && code && /^[A-Z]\\d{6}$/.test(String(code))) out.push({ json: { ...a, bls_code: String(code), idx: Number(idx) } });\n}\nreturn out;"
        }
      },
