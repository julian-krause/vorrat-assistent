      {
        "id": "d4000000-0007-4000-8000-naehrwert007",
        "name": "Ergebnis",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          2200,
          260
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "// Ergebnis je Produkt (für eBon-Import und Bot): beste Quelle, Rang, Werte, Grocy-kcal\nreturn $('Endergebnis').all().map(i => {\n  const r = i.json || {};\n  const p = r.produkt || {};\n  return { json: {\n    grocy_product_id: p.grocy_product_id ?? null, name: p.name ?? null, quelle: p.naehrwert_quelle ?? r.quelle ?? null,\n    rang: p.naehrwert_rang ?? r.rang ?? null, kcal_100: p.kcal_100 ?? null, protein_100: p.protein_100 ?? null,\n    fett_100: p.fett_100 ?? null, kh_100: p.kh_100 ?? null, gramm_pro_stk: p.gramm_pro_stk ?? null, gramm_quelle: p.gramm_quelle ?? null,\n    geschaetzt: p.geschaetzt ?? true, kcal_pro_einheit: p.kcal_pro_einheit ?? null, rewe_product_id: p.rewe_product_id ?? null,\n    naehrwerte_status: r.naehrwerte_status ?? null, gramm_status: r.gramm_status ?? null, gramm_fehler: r.gramm_fehler ?? null, hinweise: r.hinweise || [], schritte: r.schritte || [],\n    fehler: r.error ? (r.error.message || String(r.error)) : (r.detail && !r.quelle && !r.produkt ? r.detail : null),\n  } };\n});"
        }
      },
      {
        "id": "d4000000-0008-4000-8000-naehrwert008",
        "name": "Notiz",
        "type": "n8n-nodes-base.stickyNote",
        "typeVersion": 1,
        "position": [
          0,
          -320
        ],
        "parameters": {
          "width": 900,
          "height": 280,
          "color": 4,
          "content": "## Nährwerte ermitteln (Unter-Workflow)\nGenutzt vom eBon-Import, vom Bot-Tool `naehrwerte_merken` und von der Bon-Rückfrage.\n`POST /naehrwerte/ermitteln` arbeitet die Rangfolge ab: REWE (fehlende/über 7 Tage alte Details werden sofort nachgeladen) → Open Food Facts per Barcode → per Name (nur gleiche Marke) → BLS → KI. Gespeichert wird in `vorrat_produkte` (schlechter überschreibt nie besser). Danach wird das kcal-Feld in Grocy aus der View `vorrat_naehrwerte` neu gesetzt.\nRückgabe: je Produkt Quelle, Rang, Werte, `geschaetzt`."
        }
      },
      {
        "id": "d4000000-0011-4000-8000-naehrwert011",
        "name": "BLS-Aufgaben",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          660,
          260
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "// Ohne Quelle bis Rang 4 (REWE, Open Food Facts) liefert der Dienst BLS-Kandidaten: die KI wählt den passenden Eintrag\nconst anfragen = $('Anfrage bauen').all().map(i => i.json);\nconst aufgaben = [];\n$('Ermitteln').all().forEach((i, idx) => {\n  const r = i.json || {};\n  const k = r.bls_kandidaten || [];\n  if (!k.length || (r.rang !== null && r.rang !== undefined && r.rang <= 5)) return;\n  const a = anfragen[idx] || {};\n  aufgaben.push({ idx, name: a.name, kategorie: a.kategorie, kandidaten: k.slice(0, 8).map(e => ({ code: e.code, name: e.name, kcal: e.werte.kcal })) });\n});\nconst system = 'Du ordnest Lebensmittel Einträgen des Bundeslebensmittelschlüssels (BLS) zu. Antworte ausschließlich mit gültigem JSON.';\nconst prompt = 'Wähle für jedes Produkt den BLS-Eintrag, der dasselbe Lebensmittel im selben Zustand beschreibt (roh/frisch, wenn nichts anderes gesagt).\\n'\n  + 'Regeln: Nur Codes aus der jeweiligen Liste. Kein Gericht, Saft, getrocknetes oder zubereitetes Produkt für ein frisches Lebensmittel. '\n  + 'Ist es ein verarbeitetes Markenprodukt ohne passenden Grundeintrag, wähle null.\\n'\n  + 'ANTWORTFORMAT: {\"wahl\": {\"<Nummer>\": \"<Code oder null>\"}}\\n\\n'\n  + aufgaben.map(a => 'Nummer ' + a.idx + ': ' + a.name + (a.kategorie ? ' (' + a.kategorie + ')' : '') + '\\n'\n    + a.kandidaten.map(k => '  ' + k.code + ' | ' + k.name + ' | ' + k.kcal + ' kcal').join('\\n')).join('\\n\\n');\nreturn [{ json: { anzahl: aufgaben.length, system, prompt } }];"
        }
      },
