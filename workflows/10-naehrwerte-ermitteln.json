      {
        "id": "d4000000-0005-4000-8000-naehrwert005",
        "name": "Grocy-kcal bekannt?",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          2420,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "// Grocy-kcal ist nur eine Kopie der View: kcal pro Lagereinheit (g/ml: kcal/100 g ÷ 100, Stück: × Stückgewicht)\nreturn $('Endergebnis').all().map(i => (i.json && i.json.produkt) || {})\n  .filter(p => p.grocy_product_id && p.kcal_pro_einheit !== null && p.kcal_pro_einheit !== undefined)\n  .map(p => ({ json: { id: p.grocy_product_id, calories: p.kcal_pro_einheit } }));"
        }
