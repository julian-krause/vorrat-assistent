      {
        "id": "a0000000-0002-4000-8000-reweangebot02",
        "name": "Angebote holen",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          220,
          0
        ],
        "parameters": {
          "url": "http://rewe-service:8000/discounts",
          "options": {
            "timeout": 120000
          }
        }
      },
      {
        "id": "a0000000-0003-4000-8000-reweangebot03",
        "name": "Alte Angebote entfernen",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          440,
          0
        ],
        "executeOnce": true,
        "credentials": {
          "postgres": {
            "id": "RewePostgres0001",
            "name": "REWE Postgres"
          }
        },
        "parameters": {
          "operation": "executeQuery",
          "query": "UPDATE rewe_products SET angebotspreis = NULL, angebot_bis = NULL WHERE angebotspreis IS NOT NULL OR angebot_bis IS NOT NULL;",
          "options": {}
        }
      },
      {
        "id": "a0000000-0004-4000-8000-reweangebot04",
        "name": "Angebote speichern",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          660,
          0
        ],
        "executeOnce": true,
        "credentials": {
          "postgres": {
            "id": "RewePostgres0001",
            "name": "REWE Postgres"
          }
        },
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH neu AS (\n  UPDATE rewe_products p SET angebotspreis = o.angebotspreis, angebot_bis = o.angebot_bis\n  FROM jsonb_to_recordset($1::jsonb) AS o(rewe_product_id text, angebotspreis numeric, angebot_bis date)\n  WHERE p.rewe_product_id = o.rewe_product_id\n  RETURNING p.rewe_product_id\n)\nSELECT count(*) AS zugeordnet, jsonb_array_length($1::jsonb) AS angebote FROM neu;",
          "options": {
            "queryReplacement": "={{ [ JSON.stringify($('Angebote holen').first().json.angebote || []) ] }}"
          }
        }
      },
      {
        "id": "a0000000-0005-4000-8000-reweangebot05",
        "name": "Notiz",
        "type": "n8n-nodes-base.stickyNote",
        "typeVersion": 1,
        "position": [
          0,
          -260
        ],
        "parameters": {
          "width": 640,
          "height": 220,
          "color": 4,
          "content": "## REWE-Angebote\nHolt montags die Angebote des Marktes vom rewe-service (`GET /discounts`) und schreibt sie als `angebotspreis` / `angebot_bis` an die Produkte in der REWE-Datenbank (Zuordnung: Angebots-`nan` = `rewe_product_id`). Angebote ohne Produkt in der Tabelle werden ignoriert."
        }
      }
    ],
