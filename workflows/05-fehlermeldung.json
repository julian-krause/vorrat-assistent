          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const e = $('Fehler aufgetreten').first().json;\nconst chat_id = String(($('Profil laden').first().json || {}).chat_id || '');\nif (!chat_id) return [];\nconst esc = t => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst ex = e.execution || {};\nconst text = '⚠️ <b>' + esc((e.workflow || {}).name || 'Workflow') + '</b> ist fehlgeschlagen'\n  + (ex.lastNodeExecuted ? '\\nSchritt: ' + esc(ex.lastNodeExecuted) : '')\n  + '\\nFehler: ' + esc(String((ex.error || {}).message || 'unbekannt').slice(0, 600))\n  + '\\n\\nEinfach nochmal versuchen, sonst Ausführung ' + esc(ex.id || '?') + ' in n8n ansehen.';\nreturn [{ json: { chat_id, text } }];"
        }
      },
