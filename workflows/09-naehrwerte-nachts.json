      {
        "id": "e5000000-0009-4000-8000-nachts000009",
        "name": "Namen sammeln",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1100,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "// Namen und Einheit in vorrat_produkte folgen Grocy (dort benennt der Nutzer um)\nconst qu = { 4: 'g', 5: 'stk', 6: 'ml' };\nconst liste = $('Grocy-Produkte laden').all().map(i => i.json).filter(p => p && p.id)\n  .map(p => ({ id: p.id, name: p.name, einheit: qu[p.qu_id_stock] || null }));\nreturn [{ json: { liste } }];"
        }
      },
      {
        "id": "e5000000-0010-4000-8000-nachts000010",
        "name": "Namen abgleichen",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          1320,
          0
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "UPDATE vorrat_produkte v SET name = x.name, einheit = coalesce(x.einheit, v.einheit), aktualisiert_at = now()\nFROM jsonb_to_recordset($1::jsonb) AS x(id integer, name text, einheit text)\nWHERE v.grocy_product_id = x.id AND (v.name IS DISTINCT FROM x.name OR v.einheit IS DISTINCT FROM coalesce(x.einheit, v.einheit));",
          "options": {
            "queryReplacement": "={{ [ JSON.stringify($json.liste) ] }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "RewePostgres0001",
            "name": "REWE Postgres"
          }
        },
        "executeOnce": true
      },
      {
        "id": "e5000000-0011-4000-8000-nachts000011",
        "name": "Meldungen laden",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          1100,
          200
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT id, art, text FROM meldungen WHERE gesendet_at IS NULL ORDER BY id LIMIT 300;",
          "options": {}
        },
        "credentials": {
          "postgres": {
            "id": "RewePostgres0001",
            "name": "REWE Postgres"
          }
        },
        "executeOnce": true,
        "alwaysOutputData": true
      },
      {
        "id": "e5000000-0012-4000-8000-nachts000012",
        "name": "Meldung bauen",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1320,
          200
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "// Gesammelte Meldungen (Abweichungen > 20 %, unplausible Werte) + Ergebnis des Nachtlaufs als eine Telegram-Nachricht\nconst esc = t => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst m = $('Meldungen laden').all().map(i => i.json).filter(x => x && x.id);\nconst lauf = $('Nachtlauf').first().json || {};\nconst zeilen = [];\nconst titel = { abweichung: '📈 Nährwerte um mehr als 20 % geändert (möglicher Crawl-Fehler, gespeichert)', unplausibel: '⚠️ Unplausible Nährwerte (nicht übernommen)' };\nconst gruppen = {};\nfor (const x of m) (gruppen[x.art] = gruppen[x.art] || []).push(x);\nfor (const [art, liste] of Object.entries(gruppen)) {\n  zeilen.push('<b>' + esc(titel[art] || art) + '</b> (' + liste.length + ')');\n  liste.slice(0, 15).forEach(x => zeilen.push('• ' + esc(x.text)));\n  if (liste.length > 15) zeilen.push('… und ' + (liste.length - 15) + ' weitere (Tabelle meldungen)');\n}\nconst extra = [];\nconst w = lauf.warteschlange || {};\nif (w.erledigt) extra.push(w.erledigt + ' Open-Food-Facts-Anfragen nachgeholt');\nconst k = lauf.korrektur || {};\nif (k.korrigiert) extra.push(k.korrigiert + ' Verzehr-Einträge mit besserer Quelle neu berechnet');\nconst kcal = $('Grocy-kcal abweichend').all().filter(i => i.json && i.json.id).length;\nif (kcal) extra.push(kcal + ' Grocy-kcal aus der View neu gesetzt');\nif (!zeilen.length && !extra.length) return [];\nconst text = '🌙 <b>Nährwerte – Nachtlauf</b>\\n' + (extra.length ? extra.join(' · ') + '\\n' : '') + (zeilen.length ? '\\n' + zeilen.join('\\n') : '');\nreturn [{ json: { text: text.slice(0, 4000), ids: m.map(x => x.id) } }];"
        }
      },
