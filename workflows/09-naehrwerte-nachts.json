      {
        "id": "e5000000-0007-4000-8000-nachts000007",
        "name": "Grocy-kcal abweichend",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1100,
          -200
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "// Grocy-kcal ist nur eine Kopie der View vorrat_naehrwerte: abweichende Werte neu setzen\nconst grocy = {};\nfor (const i of $('Grocy-Produkte laden').all()) if (i.json && i.json.id) grocy[i.json.id] = i.json;\nconst out = [];\nfor (const i of $('Vorratswerte laden').all()) {\n  const v = i.json;\n  if (!v || !v.grocy_product_id || v.kcal_pro_einheit === null || v.kcal_pro_einheit === undefined) continue;\n  const g = grocy[v.grocy_product_id];\n  if (!g) continue;\n  if (Math.abs((Number(g.calories) || 0) - v.kcal_pro_einheit) > 0.005) out.push({ json: { id: v.grocy_product_id, calories: v.kcal_pro_einheit, vorher: Number(g.calories) || 0 } });\n}\nreturn out;"
        }
      },
      {
