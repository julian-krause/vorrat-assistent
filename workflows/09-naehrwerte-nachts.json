      {
        "id": "e5000000-0015-4000-8000-nachts000015",
        "name": "Notiz",
        "type": "n8n-nodes-base.stickyNote",
        "typeVersion": 1,
        "position": [
          0,
          -340
        ],
        "parameters": {
          "width": 820,
          "height": 260,
          "color": 4,
          "content": "## Nährwerte nachts\n1. `POST /naehrwerte/nachtlauf`: Open-Food-Facts-Warteschlange erneut versuchen, Verzehr-Korrektur (bessere Quelle → neu berechnen).\n2. Grocy-kcal aus der View `vorrat_naehrwerte` neu setzen, wo abweichend (auch nach dem Crawl).\n3. Namen/Einheit in `vorrat_produkte` an Grocy angleichen.\n4. Gesammelte `meldungen` (> 20 % Abweichung, unplausibel) per Telegram, danach als gesendet markieren.\nFehler → Workflow „Fehlermeldung“."
        }
      },
      {
        "id": "e5000000-0101-4000-8000-nachts000101",
        "name": "Unsichere Produkte laden",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          1100,
          420
        ],
        "credentials": {
          "postgres": {
            "id": "RewePostgres0001",
            "name": "REWE Postgres"
          }
        },
        "parameters": {
          "operation": "executeQuery",
          "options": {},
          "query": "SELECT v.grocy_product_id, v.name, v.einheit, v.kategorie, v.rewe_product_id, v.ean, r.brand AS marke,\n       p.kcal_100::float8 AS kcal_100, p.protein_100::float8 AS protein_100, p.fett_100::float8 AS fett_100, p.kh_100::float8 AS kh_100,\n       p.naehrwert_quelle AS werte_quelle, p.gramm_pro_stk::float8 AS gramm_pro_stk, p.gramm_quelle\nFROM vorrat_naehrwerte v JOIN vorrat_produkte p USING (grocy_product_id) LEFT JOIN rewe_products r ON r.rewe_product_id = v.rewe_product_id\nWHERE v.naehrwert_rang IS NULL OR v.naehrwert_rang >= 5 OR (v.einheit = 'stk' AND coalesce(v.gramm_rang, 4) >= 4);"
        },
        "alwaysOutputData": true,
        "executeOnce": false
