      {
        "id": "c3000000-0008-4000-8000-verzehrwf008",
        "name": "Verzehr aufbereiten",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1320,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "// Grocy-Verbrauchsbuchungen der letzten 35 Tage -> Verzehr mit festgeschriebenen Nährwerten.\n// Weggeworfen (spoiled) zählt nicht; rückgängig gemachte Buchungen werden im Protokoll als ignoriert markiert.\nconst produkte = {};\nfor (const i of $('Grocy-Produkte laden').all()) if (i.json && i.json.id) produkte[i.json.id] = i.json;\nconst qu = {};\nfor (const i of $('Grocy-Einheiten laden').all()) if (i.json && i.json.id) qu[i.json.id] = String(i.json.name || '').toLowerCase();\nconst nw = {};\nfor (const i of $('Nährwerte laden').all()) if (i.json && i.json.grocy_product_id) nw[i.json.grocy_product_id] = i.json;\nconst einheitVon = p => { const n = qu[p.qu_id_stock] || ''; return n === 'gramm' ? 'g' : n === 'milliliter' ? 'ml' : 'stk'; };\nconst r1 = x => (x === null || x === undefined || !Number.isFinite(x)) ? null : Math.round(x * 10) / 10;\nconst neu = [];\nconst rueck = [];\nfor (const i of $('Grocy-Verbrauch laden').all()) {\n  const l = i.json;\n  if (!l || !l.id) continue;\n  if (Number(l.undone) === 1) { rueck.push(l.id); continue; }\n  if (Number(l.spoiled) === 1 || l.transaction_type !== 'consume') continue;\n  const menge = Math.abs(Number(l.amount) || 0);\n  if (!menge) continue;\n  const p = produkte[l.product_id] || {};\n  const n = nw[l.product_id] || {};\n  const einheit = n.einheit || einheitVon(p);\n  const gramm = (einheit === 'g' || einheit === 'ml') ? menge : (Number(n.gramm_pro_stk) > 0 ? menge * Number(n.gramm_pro_stk) : null);\n  const hat = n.kcal_100 !== null && n.kcal_100 !== undefined && gramm !== null;\n  const f = hat ? gramm / 100 : 0;\n  const makro = k => hat && n[k] !== null && n[k] !== undefined ? r1(Number(n[k]) * f) : null;\n  neu.push({\n    log_id: l.id, zeitpunkt: l.row_created_timestamp, product_id: l.product_id, name: p.name || n.name || ('Produkt ' + l.product_id),\n    menge, einheit, gramm: r1(gramm),\n    // ohne Nährwert-Eintrag: Grocy-Kalorien pro Lagereinheit als Rückfall\n    kcal: hat ? r1(Number(n.kcal_100) * f) : (Number(p.calories) > 0 ? r1(Number(p.calories) * menge) : null),\n    protein: makro('protein_100'), fett: makro('fett_100'), kh: makro('kh_100'),\n    geschaetzt: !hat || n.quelle === 'ki-schaetzung',\n  });\n}\nreturn [{ json: { neu, rueck, anzahl: neu.length } }];"
        }
      },
      {
        "id": "c3000000-0009-4000-8000-verzehrwf009",
        "name": "Verzehr speichern",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          1540,
          0
        ],
        "executeOnce": true,
        "credentials": {
          "postgres": {
            "id": "RewePostgres0001",
            "name": "REWE Postgres"
          }
        },
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH neu AS (\n  INSERT INTO verzehr (zeitpunkt, quelle, grocy_log_id, grocy_product_id, name, menge, einheit, gramm, kcal, protein, fett, kh, geschaetzt)\n  SELECT (e->>'zeitpunkt')::timestamp AT TIME ZONE 'Europe/Berlin', 'grocy', (e->>'log_id')::int, (e->>'product_id')::int, e->>'name',\n         (e->>'menge')::numeric, e->>'einheit', (e->>'gramm')::numeric, (e->>'kcal')::numeric, (e->>'protein')::numeric,\n         (e->>'fett')::numeric, (e->>'kh')::numeric, (e->>'geschaetzt')::boolean\n  FROM jsonb_array_elements($1::jsonb) e\n  ON CONFLICT (grocy_log_id) DO NOTHING RETURNING 1\n), rueck AS (\n  UPDATE verzehr SET ignoriert = true, notiz = coalesce(notiz, 'in Grocy rückgängig gemacht')\n  WHERE grocy_log_id IN (SELECT x::int FROM jsonb_array_elements_text($2::jsonb) x) AND NOT ignoriert RETURNING 1\n)\nSELECT (SELECT count(*) FROM neu) AS neu, (SELECT count(*) FROM rueck) AS rueckgaengig;",
          "options": {
            "queryReplacement": "={{ [ JSON.stringify($json.neu || []), JSON.stringify($json.rueck || []) ] }}"
          }
        }
      },
      {
        "id": "c3000000-0010-4000-8000-verzehrwf010",
        "name": "Notiz",
        "type": "n8n-nodes-base.stickyNote",
        "typeVersion": 1,
        "position": [
          0,
          -300
        ],
        "parameters": {
          "width": 760,
          "height": 260,
          "color": 4,
          "content": "## Verzehr erfassen\nÜbernimmt alle 5 Minuten die Verbrauchsbuchungen aus Grocy (letzte 35 Tage, idempotent über die stock_log-ID) in die Tabelle `verzehr` (REWE-Postgres), mit Nährwerten aus `vorrat_produkte` zum Zeitpunkt des Essens. Weggeworfenes zählt nicht, rückgängig Gemachtes wird als ignoriert markiert.\nWeitere Quellen: „✅ Gekocht“ (Zutaten ohne Vorrat) und der Agent (auswärts Gegessenes). Auswertung: Funktion `verzehr_auswertung(von, bis)`.\nErfolgreiche Läufe werden nicht gespeichert (Einstellungen), Fehler schon."
        }
      }
