      {
        "id": "7ca9fc5c-69f9-4660-a899-4500aec9614d",
        "name": "Tagesbericht bauen",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1120,
          192
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const profil = $('Profil laden').first().json || {};\nconst chat_id = String(profil.chat_id || '');\nif (!chat_id) return [];\nconst zone = 'Europe/Berlin';\nconst heute = DateTime.now().setZone(zone).startOf('day');\nconst esc = t => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst qu = {};\nfor (const i of $('Grocy-Einheiten laden').all()) if (i.json && i.json.id) qu[i.json.id] = i.json.name;\nconst v = $('Grocy: bald fällig & abgelaufen').first().json || {};\nconst tageBis = d => Math.round(DateTime.fromISO(String(d).slice(0, 10), { zone }).diff(heute, 'days').days);\nconst menge = p => (Math.round(Number(p.amount) * 10) / 10) + ' ' + (qu[(p.product || {}).qu_id_stock] || '');\nconst out = [];\n\nconst bald = (v.due_products || []).filter(p => Number(p.amount) > 0).sort((a, b) => String(a.best_before_date).localeCompare(String(b.best_before_date)));\nif (bald.length) {\n  const wann = t => t <= 0 ? '<b>heute</b>' : t === 1 ? 'morgen' : 'übermorgen';\n  const zeilen = bald.map(p => '• ' + esc((p.product || {}).name) + ' (' + esc(menge(p)) + ') – ' + wann(tageBis(p.best_before_date)));\n  out.push({ json: { typ: 'bericht', chat_id, text: '🍽️ <b>Iss am besten bald – sonst läuft es ab:</b>\\n' + zeilen.join('\\n') + '\\n\\nSoll ich dir Rezepte genau damit vorschlagen?' } });\n}\n\nconst alt = [...(v.overdue_products || []), ...(v.expired_products || [])].filter(p => Number(p.amount) > 0);\nconst gesehen = {};\nfor (const p of alt) {\n  if (gesehen[p.product_id]) continue;\n  gesehen[p.product_id] = true;\n  const t = -tageBis(p.best_before_date);\n  out.push({ json: { typ: 'abgelaufen', chat_id, product_id: p.product_id, text: '⏰ <b>' + esc((p.product || {}).name) + '</b> (' + esc(menge(p)) + ') ist laut MHD seit ' + (t <= 1 ? 'gestern' : t + ' Tagen') + ' abgelaufen. Noch da und gut?' } });\n  if (out.filter(o => o.json.typ === 'abgelaufen').length >= 8) break;\n}\n\nconst reihenfolge = { 'Frühstück': 0, 'Mittag': 1, 'Abend': 2, 'Snack': 3, 'Snack 2': 4 };\nconst plan = $('Wochenplan laden').all().map(i => i.json).filter(r => r && r.id && r.geplant_fuer && DateTime.fromJSDate(new Date(r.geplant_fuer)).setZone(zone).toISODate() === heute.toISODate())\n  .sort((a, b) => (reihenfolge[a.mahlzeit] ?? 9) - (reihenfolge[b.mahlzeit] ?? 9));\nfor (const r of plan) {\n  let zutaten = [];\n  try { zutaten = JSON.parse(r.zutaten_json || '[]'); } catch (e) { zutaten = []; }\n  const zText = zutaten.map(z => '• ' + (z.menge ? (Math.round(Number(z.menge) * 10) / 10) + ' ' + esc(z.einheit) + ' ' : '') + esc(z.name) + (z.product_id == null ? ' 🛒' : '')).join('\\n');\n  const text = '📅 <b>Heute ' + esc(r.mahlzeit) + ': ' + esc(r.titel) + '</b>\\n' + (r.kcal || 0) + ' kcal · P ' + (r.protein_g || 0) + ' g · F ' + (r.fett_g || 0) + ' g · KH ' + (r.kh_g || 0) + ' g'\n    + '\\n\\n<b>Zutaten</b>\\n' + zText + '\\n\\n<b>Zubereitung</b>\\n' + esc(r.anleitung || '');\n  out.push({ json: { typ: 'mahlzeit', chat_id, rezept_id: r.id, text: text.slice(0, 4000) } });\n}\nreturn out;"
        }
