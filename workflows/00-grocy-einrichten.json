      {
        "id": "708f96e9-c8a7-476d-96fc-c339ee1625ce",
        "name": "Fehlendes ermitteln",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1344,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const norm = s => String(s || '').trim().toLowerCase();\nconst qus = $('Einheiten laden').all().map(i => i.json).filter(r => r && r.id);\nconst locs = $('Lagerorte laden').all().map(i => i.json).filter(r => r && r.id);\nconst out = [];\nfor (const q of [ { name: 'Gramm', name_plural: 'Gramm' }, { name: 'Milliliter', name_plural: 'Milliliter' }, { name: 'Stück', name_plural: 'Stück' } ]) {\n  if (!qus.some(r => norm(r.name) === norm(q.name))) out.push({ json: { endpoint: 'quantity_units', body: q } });\n}\nfor (const l of [ { name: 'Kühlschrank', is_freezer: 0 }, { name: 'Tiefkühler', is_freezer: 1 }, { name: 'Vorratsschrank', is_freezer: 0 } ]) {\n  if (!locs.some(r => norm(r.name) === norm(l.name))) out.push({ json: { endpoint: 'locations', body: l } });\n}\nreturn out;"
        }
      },
